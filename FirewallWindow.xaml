<Window x:Class="NetworkTroubleshooter.FirewallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="防火墙+++" Height="180" Width="320"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FFE0E0E0" FontFamily="Microsoft YaHei">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="防火墙+++" FontSize="18" FontWeight="Bold" 
                   Margin="0,0,0,8" Foreground="#CC0000" HorizontalAlignment="Left"/>

        <!-- 状态条 -->
        <Border Grid.Row="1" BorderBrush="#888" BorderThickness="1" CornerRadius="4"
                Background="#FFF0F0F0" Padding="8" Margin="0,4">
            <StackPanel VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="statusLed" Width="14" Height="14" Fill="Red" 
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" x:Name="txtStatus" Text="未连接" 
                               VerticalAlignment="Center" FontSize="13"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="btnCancel" Content="取消" Width="70" Height="28" 
                    Margin="0,0,10,0" Click="btnCancel_Click"/>
            <Button x:Name="btnConnect" Content="确定" Width="70" Height="28" 
                    Click="btnConnect_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>