<Window x:Class="NetworkTroubleshooter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows 网络故障诊断" Height="520" Width="600"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F0F0F0" FontFamily="Microsoft YaHei"
        >

    <Window.Resources>
        <Style x:Key="RetroLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#0066CC"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" Background="Transparent">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="TextDecorations" Value="Underline"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F0F0F0" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="25,0">
                <TextBlock Text="解决并帮助预防计算机网络问题" FontSize="11" Foreground="#666666"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="45,15,37,15">
            <StackPanel x:Name="pnlWelcome" Visibility="Visible">
                <StackPanel Orientation="Horizontal" Margin="0,15,0,25">
                    <Image Source="interneticon.png" Width="51" Height="57" Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBlock Text="网络连接验证" FontSize="20" Foreground="#004578" Margin="20,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="    此疑难解答有助于检测并修复连接问题。" TextWrapping="Wrap" Margin="60,0,0,0" LineHeight="20" Foreground="#333333"/>
                <StackPanel Orientation="Horizontal" Margin="60,10,0,0" Width="405">
                    <TextBlock x:Name="txtAdvanced" Text="高级" Foreground="#0078D7" Cursor="Hand" MouseLeftButtonDown="txtAdvanced_MouseLeftButtonDown"/>
                    <CheckBox x:Name="chkAdvancedFix" Content="启用高级修复" Margin="20,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="     发布者: Microsoft Corporation" Margin="60,15,0,0" Foreground="#666666" FontSize="11"/>
            </StackPanel>

            <StackPanel x:Name="pnlProgress" Visibility="Collapsed">
                <TextBlock Text="正在检测问题" FontSize="18" Foreground="#004578" Margin="0,10,0,35"/>
                <TextBlock x:Name="txtStatus" Text="正在验证服务状态..." Margin="0,0,0,12" Foreground="#333333"/>
                <ProgressBar x:Name="pBar" Height="14" BorderBrush="#D0D0D0" IsIndeterminate="True"/>
            </StackPanel>

            <StackPanel x:Name="pnlResult" Visibility="Collapsed">
                <TextBlock Text="疑难解答已完成" FontSize="19" Foreground="#004578" Margin="0,5,0,20"/>
                <TextBlock Text="找到的问题" FontWeight="SemiBold" FontSize="14" Foreground="#333333" Margin="0,0,0,12"/>

                <Grid Margin="10,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="网关设置" Foreground="#333333" VerticalAlignment="Center" FontSize="13"/>
                    <TextBlock Grid.Column="1" Text="已修复" Foreground="#333333" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="13"/>
                    <TextBlock Grid.Column="2" Text="✔" Foreground="#008000" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,2,0"/>
                </Grid>

                <Border BorderBrush="#DFDFDF" BorderThickness="0,1,0,0" Margin="0,0,0,15"/>

                <StackPanel>
                    <Button x:Name="btnBrowseOptions" Content="→ 浏览其他选项" Style="{StaticResource RetroLinkButtonStyle}" Margin="0,0,0,8" Click="btnBrowseOptions_Click"/>
                    <Button x:Name="btnCloseTroubleshooter" Content="→ 关闭疑难解答" Style="{StaticResource RetroLinkButtonStyle}" Click="btnCloseTroubleshooter_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="#E1E1E1" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0">
                <Button x:Name="btnNext" Content="下一步(_N)" Width="90" Height="26" Click="btnNext_Click" IsDefault="True"/>
                <Button x:Name="btnCancel" Content="取消" Width="90" Height="26" Margin="10,0,0,0" Click="btnCancel_Click" IsCancel="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>